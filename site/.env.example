# Copy to .env (or .env.local) and set only what you need.
# The site builds and runs with no backend and no variables set.

# --- Build-time content source -------------------------------------------
# markdown: read site/content/blog/*.md (default)
# api:      GET the posts endpoint while building, then prerender as usual
BLOG_SOURCE=markdown

# Required when BLOG_SOURCE=api. Base URL only, no trailing slash.
# BLOG_API_URL=https://api.example.com

# Optional: bearer token sent as `Authorization: Bearer <token>`.
# BLOG_API_TOKEN=

# Optional: path appended to BLOG_API_URL. Default: /posts
# BLOG_API_POSTS_PATH=/posts

# Optional: request deadline in milliseconds. Default: 15000
# BLOG_API_TIMEOUT_MS=15000

# --- Runtime API (client-side features only) ------------------------------
# Only VITE_* variables reach the browser. Never put secrets in them.
# Indexable content must stay build-time; this is for comments, forms,
# reactions, search, and other interactive requests.
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_TIMEOUT_MS=15000
